{
  "name": "vastukosh-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vastukosh API — Node.js + TypeScript + MongoDB + GraphQL (Pothos code-first). Modular, client-agnostic (web + future mobile).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "print-schema": "tsx src/graphql/print-schema.ts",
    "check-schema": "tsx src/graphql/check-schema.ts",
    "pretest": "npm run check-schema",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express4": "1.1.2",
    "@pothos/core": "4.4.0",
    "@pothos/plugin-dataloader": "4.4.0",
    "@pothos/plugin-relay": "4.4.0",
    "@pothos/plugin-scope-auth": "4.1.3",
    "@pothos/plugin-simple-objects": "4.1.0",
    "@pothos/plugin-zod": "4.1.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dataloader": "2.2.3",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "graphql": "16.11.0",
    "graphql-scalars": "1.24.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "nanoid": "5.0.9",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "vedic-panchanga": "^0.2.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "mongodb-memory-server": "10.1.3",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
