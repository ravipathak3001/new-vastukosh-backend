# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────────────────────────
# Local docker-compose default, or point at MongoDB Atlas.
MONGODB_URI=mongodb://localhost:27017/vastukosh

# ─── Auth ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TTL=15m
REFRESH_TTL=30d
# Cookie the web client uses to carry the refresh token. Leave COOKIE_DOMAIN blank for localhost.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# ─── Payments ─────────────────────────────────────────────────────────────
# mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── SEO / frontend integration ───────────────────────────────────────────
# Canonical public origin of the storefront (used to build sitemap URLs).
SITE_URL=http://localhost:3000
# On catalog changes the API POSTs here so Next.js can revalidate cached pages.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret-change-me

# ─── Panchang ─────────────────────────────────────────────────────────────
# Fallback location used by the `panchang` query when the client sends no
# latitude/longitude. Defaults below are New Delhi.
PANCHANG_DEFAULT_LAT=28.6139
PANCHANG_DEFAULT_LNG=77.209
PANCHANG_DEFAULT_TZ=Asia/Kolkata
PANCHANG_DEFAULT_PLACE=New Delhi, India
